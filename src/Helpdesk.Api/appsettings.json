{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Helpdesk": {
    "TimeZone": "America/Guayaquil",
    "OfficeCalendarCode": "ec-office",
    "AutoCloseBusinessDays": 3
  },
  "Jwt": {
    "Issuer": "helpdesk-net",
    "Audience": "helpdesk-net-api",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  },
  "Storage": {
    "AttachmentsPath": "data/attachments"
  },
  "Workers": {
    "Enabled": true,
    "SlaMonitorIntervalSeconds": 30
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "OpenApi": {
    "Enabled": true
  }
}
