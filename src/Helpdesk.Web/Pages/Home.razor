@page "/"
@attribute [Authorize]
@implements IDisposable
@inject SessionService Session
@inject HelpdeskApi Api
@inject RealtimeClient Realtime
@inject NavigationManager Navigation

<PageTitle>Inicio · helpdesk-net</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <div>
        <MudText Typo="Typo.h4" HtmlTag="h1">Hola, @FirstName</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@(Session.IsCustomer ? "Sigue el estado de tus solicitudes." : "Esto es lo que necesita atención ahora.")</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="tickets/nuevo">Nuevo ticket</MudButton>
</MudStack>

@if (Session.IsStaff)
{
    <MudGrid Spacing="3" Class="mb-4">
        @if (Session.IsSupervisor)
        {
            <MudItem xs="6" md="3"><KpiCard Title="Abiertos" Value="@_openTotal.ToString()" Icon="@Icons.Material.Filled.ConfirmationNumber" Caption="En todas las colas" /></MudItem>
        }
        else
        {
            <MudItem xs="6" md="3"><KpiCard Title="Asignados a mí" Value="@_mine.TotalCount.ToString()" Icon="@Icons.Material.Filled.AssignmentInd" /></MudItem>
        }
        <MudItem xs="6" md="3"><KpiCard Title="Sin asignar en mis colas" Value="@_unassigned.ToString()" Icon="@Icons.Material.Filled.Inbox" Color="Color.Info" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Title="SLA en riesgo" Value="@_atRisk.TotalCount.ToString()" Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" /></MudItem>
        <MudItem xs="6" md="3"><KpiCard Title="SLA incumplido" Value="@_breached.TotalCount.ToString()" Icon="@Icons.Material.Filled.Error" Color="Color.Error" Caption="Tickets abiertos fuera de objetivo" /></MudItem>
    </MudGrid>

    <MudGrid Spacing="3">
        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Riesgo de SLA (por vencimiento)</MudText>
                <TicketTable Items="@RiskItems" Loading="@_loading" ShowCustomer="false" Compact="true" EmptyText="Ningún ticket en riesgo." OnOpen="Open" />
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="6">
            <MudPaper Class="pa-4" Elevation="1">
                @if (Session.IsSupervisor)
                {
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Nuevos sin asignar</MudText>
                    <TicketTable Items="@_mine.Items" Loading="@_loading" ShowCustomer="false" Compact="true" EmptyText="No hay tickets esperando asignación." OnOpen="Open" />
                }
                else
                {
                    <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Mis tickets abiertos</MudText>
                    <TicketTable Items="@_mine.Items" Loading="@_loading" ShowCustomer="false" Compact="true" EmptyText="No tienes tickets asignados." OnOpen="Open" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else
{
    <MudPaper Class="pa-4" Elevation="1">
        <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Mis solicitudes recientes</MudText>
        <TicketTable Items="@_mine.Items" Loading="@_loading" ShowCustomer="false" EmptyText="Aún no registras solicitudes." OnOpen="Open" />
    </MudPaper>
}

@code {
    private static readonly PagedResult<TicketListItemDto> Empty = new([], 1, 10, 0);
    private PagedResult<TicketListItemDto> _mine = Empty;
    private PagedResult<TicketListItemDto> _atRisk = Empty;
    private PagedResult<TicketListItemDto> _breached = Empty;
    private int _unassigned;
    private int _openTotal;
    private bool _loading = true;
    private CancellationTokenSource? _debounce;

    private string FirstName => Session.User?.FullName.Split(' ')[0] ?? string.Empty;

    private IReadOnlyList<TicketListItemDto> RiskItems => [.. _breached.Items.Concat(_atRisk.Items).OrderBy(Labels.ActiveDue).Take(10)];

    protected override async Task OnInitializedAsync()
    {
        Realtime.TicketChanged += OnTicketChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (Session.IsStaff)
            {
                // Supervisión no recibe asignaciones: su segunda tarjeta es la cola de nuevos por repartir.
                var mine = Api.ListTicketsAsync(Session.IsSupervisor
                    ? new TicketQuery { Status = TicketStatus.New, Sort = TicketSort.DueDate, PageSize = 10 }
                    : new TicketQuery { AssignedToMe = true, OpenOnly = true, Sort = TicketSort.DueDate, PageSize = 10 });
                var atRisk = Api.ListTicketsAsync(new TicketQuery { Sla = SlaState.AtRisk, Sort = TicketSort.DueDate, PageSize = 10 });
                var breached = Api.ListTicketsAsync(new TicketQuery { Sla = SlaState.Breached, Sort = TicketSort.DueDate, PageSize = 10 });
                var unassigned = Api.ListTicketsAsync(new TicketQuery { Status = TicketStatus.New, PageSize = 1 });
                var open = Api.ListTicketsAsync(new TicketQuery { OpenOnly = true, PageSize = 1 });
                await Task.WhenAll(mine, atRisk, breached, unassigned, open);
                (_mine, _atRisk, _breached) = (mine.Result, atRisk.Result, breached.Result);
                (_unassigned, _openTotal) = (unassigned.Result.TotalCount, open.Result.TotalCount);
            }
            else
            {
                _mine = await Api.ListTicketsAsync(new TicketQuery { PageSize = 10 });
            }
        }
        catch (ApiException)
        {
            // La tabla queda vacía; el detalle del error se ve al navegar.
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTicketChanged(TicketChangedMessage message)
    {
        // Varios eventos seguidos se agrupan en una sola recarga.
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                await LoadAsync();
                StateHasChanged();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private void Open(TicketListItemDto ticket) => Navigation.NavigateTo($"tickets/{ticket.Id}");

    public void Dispose()
    {
        Realtime.TicketChanged -= OnTicketChanged;
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
