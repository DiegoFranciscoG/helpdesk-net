@page "/tickets"
@attribute [Authorize]
@implements IDisposable
@inject SessionService Session
@inject HelpdeskApi Api
@inject RealtimeClient Realtime
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Tickets · helpdesk-net</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4" HtmlTag="h1">@(Session.IsCustomer ? "Mis tickets" : "Tickets")</MudText>
    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
        @if (_liveUpdates > 0)
        {
            <MudChip T="string" Color="Color.Info" Size="Size.Small" Icon="@Icons.Material.Filled.Bolt">@(_liveUpdates == 1 ? "1 cambio en vivo" : $"{_liveUpdates} cambios en vivo")</MudChip>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Href="tickets/nuevo">Nuevo ticket</MudButton>
    </MudStack>
</MudStack>

<MudPaper Class="pa-4 mb-3" Elevation="1">
    <MudGrid Spacing="2">
        <MudItem xs="12" md="3">
            <MudTextField T="string" @bind-Value="_query.Search" Label="Buscar (título o HD-000123)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="400" OnDebounceIntervalElapsed="@(_ => ReloadAsync(resetPage: true))" Clearable="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="TicketStatus?" Value="_query.Status" ValueChanged="@(async v => { _query.Status = v; await ReloadAsync(true); })" Label="Estado" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var status in Enum.GetValues<TicketStatus>())
                {
                    <MudSelectItem T="TicketStatus?" Value="@status">@Labels.Status(status)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="Priority?" Value="_query.Priority" ValueChanged="@(async v => { _query.Priority = v; await ReloadAsync(true); })" Label="Prioridad" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var priority in Enum.GetValues<Priority>())
                {
                    <MudSelectItem T="Priority?" Value="@priority">@Labels.Priority(priority)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="SlaState?" Value="_query.Sla" ValueChanged="@(async v => { _query.Sla = v; await ReloadAsync(true); })" Label="SLA" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (var sla in Enum.GetValues<SlaState>())
                {
                    <MudSelectItem T="SlaState?" Value="@sla">@Labels.Sla(sla)</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        @if (Session.IsStaff)
        {
            <MudItem xs="6" md="3">
                <MudSelect T="Guid?" Value="_query.TeamId" ValueChanged="@(async v => { _query.TeamId = v; await ReloadAsync(true); })" Label="Cola" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (var team in _teams)
                    {
                        <MudSelectItem T="Guid?" Value="@team.Id">@team.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12" md="6">
            <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                <MudSwitch T="bool" Value="_query.OpenOnly" ValueChanged="@(async v => { _query.OpenOnly = v; await ReloadAsync(true); })" Color="Color.Primary" Label="Solo abiertos" />
                @if (Session.IsStaff)
                {
                    <MudSwitch T="bool" Value="_query.AssignedToMe" ValueChanged="@(async v => { _query.AssignedToMe = v; await ReloadAsync(true); })" Color="Color.Primary" Label="Asignados a mí" />
                }
            </MudStack>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudSelect T="TicketSort" Value="_query.Sort" ValueChanged="@(async v => { _query.Sort = v; await ReloadAsync(true); })" Label="Ordenar por" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="TicketSort" Value="TicketSort.Newest">Más recientes</MudSelectItem>
                <MudSelectItem T="TicketSort" Value="TicketSort.Priority">Prioridad</MudSelectItem>
                <MudSelectItem T="TicketSort" Value="TicketSort.DueDate">Vencimiento de SLA</MudSelectItem>
            </MudSelect>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-2" Elevation="1">
    <TicketTable Items="@_page.Items" Loading="@_loading" ShowCustomer="@Session.IsStaff" OnOpen="Open" EmptyText="No hay tickets con esos filtros." />
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="pa-2">
        <MudText Typo="Typo.caption">@_page.TotalCount tickets</MudText>
        <MudPagination Count="@Math.Max(1, _page.TotalPages)" Selected="@_query.Page" SelectedChanged="@(async p => { _query.Page = p; await ReloadAsync(false); })" Size="Size.Small" />
    </MudStack>
</MudPaper>

@code {
    private readonly TicketQuery _query = new() { OpenOnly = true, PageSize = 15 };
    private PagedResult<TicketListItemDto> _page = new([], 1, 15, 0);
    private List<TeamDto> _teams = [];
    private bool _loading;
    private int _liveUpdates;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        Realtime.TicketChanged += OnTicketChanged;
        if (Session.IsStaff)
        {
            try
            {
                _teams = await Api.TeamsAsync();
            }
            catch (ApiException)
            {
                _teams = [];
            }
        }

        await ReloadAsync(false);
    }

    private async Task ReloadAsync(bool resetPage)
    {
        if (resetPage)
        {
            _query.Page = 1;
        }

        _loading = true;
        try
        {
            _page = await Api.ListTicketsAsync(_query);
        }
        catch (ApiException ex)
        {
            Snackbar.Add(ex.Friendly, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnTicketChanged(TicketChangedMessage message)
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(400, token);
                _liveUpdates++;
                await ReloadAsync(false);
                StateHasChanged();
            }
            catch (TaskCanceledException)
            {
            }
        });
    }

    private void Open(TicketListItemDto ticket) => Navigation.NavigateTo($"tickets/{ticket.Id}");

    public void Dispose()
    {
        Realtime.TicketChanged -= OnTicketChanged;
        _debounce?.Cancel();
        _debounce?.Dispose();
    }
}
