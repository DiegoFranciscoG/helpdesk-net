@* Tabla de tickets reutilizable (tablero y listado). Muestra el semáforo de SLA con tiempo relativo. *@
<MudTable T="TicketListItemDto" Items="@Items" Hover="true" Dense="true" Loading="@Loading" Breakpoint="Breakpoint.Sm"
          OnRowClick="@(args => OnOpen.InvokeAsync(args.Item))" RowStyle="cursor:pointer" Elevation="0">
    <HeaderContent>
        <MudTh>Número</MudTh>
        <MudTh>Título</MudTh>
        <MudTh>Estado</MudTh>
        @if (!Compact)
        {
            <MudTh>Prioridad</MudTh>
        }
        <MudTh>SLA</MudTh>
        @if (ShowCustomer)
        {
            <MudTh>Cliente</MudTh>
        }
        @if (!Compact)
        {
            <MudTh>Cola / asignado</MudTh>
            <MudTh>Creado</MudTh>
        }
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Número" Class="text-nowrap"><MudLink Href="@($"tickets/{context.Id}")" Typo="Typo.body2">@context.Number</MudLink></MudTd>
        <MudTd DataLabel="Título" Class="ticket-title">
            @context.Title
            @if (context.EscalationLevel == 2)
            {
                <MudTooltip Text="Escalado a líderes y supervisión">
                    <MudIcon Icon="@Icons.Material.Filled.PriorityHigh" Color="Color.Error" Size="Size.Small" aria-label="Escalado" />
                </MudTooltip>
            }
        </MudTd>
        @if (Compact)
        {
            <MudTd DataLabel="Estado">
                <div class="chip-stack">
                    <Chips Kind="Chips.ChipKind.Status" Status="@context.Status" />
                    <Chips Kind="Chips.ChipKind.Priority" Priority="@context.Priority" />
                </div>
            </MudTd>
        }
        else
        {
            <MudTd DataLabel="Estado"><Chips Kind="Chips.ChipKind.Status" Status="@context.Status" /></MudTd>
            <MudTd DataLabel="Prioridad"><Chips Kind="Chips.ChipKind.Priority" Priority="@context.Priority" /></MudTd>
        }
        <MudTd DataLabel="SLA">
            <Chips Kind="Chips.ChipKind.Sla" Sla="@context.SlaState" />
            @if (context.SlaState is SlaState.OnTrack or SlaState.AtRisk or SlaState.Breached)
            {
                @* Mientras falte la primera respuesta, ese es el reloj que manda (y el que explica un "Incumplido"). *@
                var pendingResponse = context.FirstRespondedAt is null;
                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">
                    @(pendingResponse ? "1.ª respuesta" : "Resolución"): @Labels.Relative(Labels.ActiveDue(context), DateTimeOffset.UtcNow)
                </MudText>
            }
        </MudTd>
        @if (ShowCustomer)
        {
            <MudTd DataLabel="Cliente">@context.CustomerName <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.CustomerCode</MudText></MudTd>
        }
        @if (!Compact)
        {
            <MudTd DataLabel="Cola / asignado">
                @context.TeamName
                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary">@(context.AssigneeName ?? "Sin asignar")</MudText>
            </MudTd>
            <MudTd DataLabel="Creado">@Labels.ShortDate(context.CreatedAt)</MudTd>
        }
    </RowTemplate>
    <NoRecordsContent>
        <MudText Typo="Typo.body2" Class="pa-4">@EmptyText</MudText>
    </NoRecordsContent>
</MudTable>

@code {
    [Parameter]
    public IReadOnlyList<TicketListItemDto> Items { get; set; } = [];

    /// <summary>Versión angosta para tarjetas del tablero: oculta cola y fecha de creación.</summary>
    [Parameter]
    public bool Compact { get; set; }

    [Parameter]
    public bool Loading { get; set; }

    [Parameter]
    public bool ShowCustomer { get; set; } = true;

    [Parameter]
    public string EmptyText { get; set; } = "No hay tickets.";

    [Parameter]
    public EventCallback<TicketListItemDto> OnOpen { get; set; }
}
