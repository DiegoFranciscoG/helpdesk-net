# Copia este archivo como .env (nunca se versiona) y completa los valores.
# Genera cada secreto con:  openssl rand -base64 48
# Los obligatorios no tienen valor por defecto: docker compose no arranca si falta alguno.

# --- Obligatorios
HELPDESK_DB_PASSWORD=
# Clave HS256 de los JWT: 32 bytes (256 bits) aleatorios como mínimo.
HELPDESK_JWT_SIGNING_KEY=
# Contraseña de los usuarios demo (admin@, supervisor@, agente@, cliente@helpdesk.example): 15+ caracteres.
HELPDESK_DEMO_PASSWORD=

# --- Opcionales
# Secreto del cliente de integración "nlp-tickets-es" (32+ caracteres) para pedir un JWT en POST /api/v1/auth/token.
HELPDESK_INTEGRATION_CLIENT_SECRET=
# Clasificador nlp-tickets-es (P27). Si lo levantas en este equipo: http://host.docker.internal:8000
HELPDESK_NLP_URL=
HELPDESK_NLP_API_KEY=
HELPDESK_NLP_REVIEWER_API_KEY=
# Logins (5) y renovaciones de sesión (30) por minuto e IP. Súbelos solo para las pruebas e2e.
HELPDESK_AUTH_RATE_LIMIT=
HELPDESK_REFRESH_RATE_LIMIT=
